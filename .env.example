DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters-12345
DJANGO_ENV=development
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECURE_SSL_REDIRECT=False
# Docker Compose uses PostgreSQL. These defaults are suitable for local development.
# POSTGRES_DB=task_manager
# POSTGRES_USER=task_manager
# POSTGRES_PASSWORD=task_manager_dev_password
# PostgreSQL is selected automatically by Compose through POSTGRES_HOST.
# Local non-Compose development falls back to SQLite in the ignored project file.
# SQLITE_DB_PATH=/data/db.sqlite3
# Compose overrides these Redis hostnames with the Docker service name `redis`.
# REDIS_CACHE_URL=redis://localhost:6379/3
CHANNEL_LAYER_REDIS_URL=redis://localhost:6379/2
# Public HTTP port for the Nginx service.
NGINX_PORT=8000
# AI provider: gemini or openai
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_API_KEY=replace-with-your-provider-key
AI_API_TIMEOUT=30
AI_MAX_INPUT_CHARS=4000
