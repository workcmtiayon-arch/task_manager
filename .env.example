SECRET_KEY=your-secret-key-here
DJANGO_ENV=development
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECURE_SSL_REDIRECT=False
# Docker keeps SQLite in a named volume; leave this unset for local development.
# SQLITE_DB_PATH=/data/db.sqlite3
# Redis hostnames are overridden by docker-compose for container-to-container traffic.
# REDIS_CACHE_URL=redis://localhost:6379/3
# Redis database used by Django Channels for live chat fan-out.
CHANNEL_LAYER_REDIS_URL=redis://localhost:6379/2
# AI provider: gemini or openai
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_API_KEY=replace-with-your-provider-key
AI_API_TIMEOUT=30
AI_MAX_INPUT_CHARS=4000
